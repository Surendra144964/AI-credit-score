    <script>
        // Theme Toggle
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;
        const icon = themeToggle.querySelector('i');

        // Check for saved theme preference
        const currentTheme = localStorage.getItem('theme');
        if (currentTheme === 'dark') {
            body.classList.add('dark-mode');
            icon.classList.remove('fa-moon');
            icon.classList.add('fa-sun');
        }

        themeToggle.addEventListener('click', () => {
            body.classList.toggle('dark-mode');
            
            if (body.classList.contains('dark-mode')) {
                localStorage.setItem('theme', 'dark');
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
            } else {
                localStorage.setItem('theme', 'light');
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
            }
        });

        // Form Toggle
        const showLogin = document.getElementById('showLogin');
        const showRegister = document.getElementById('showRegister');
        const loginForm = document.getElementById('loginForm');
        const signupForm = document.getElementById('signupForm');

        showLogin.addEventListener('click', (e) => {
            e.preventDefault();
            signupForm.style.display = 'none';
            loginForm.style.display = 'block';
        });

        showRegister.addEventListener('click', (e) => {
            e.preventDefault();
            loginForm.style.display = 'none';
            signupForm.style.display = 'block';
        });

        // Form Submission
        document.getElementById('registerForm').addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Thank you for signing up! Redirecting to your dashboard...');
            // In a real app, you would handle the form submission here
        });

        document.getElementById('signinForm').addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Welcome back! Redirecting to your dashboard...');
            // In a real app, you would handle the form submission here
        });

        // Chatbot Functionality with Google Gemini API
        const chatbotIcon = document.getElementById("chatbotIcon");
        const chatbotWindow = document.getElementById("chatbotWindow");
        const closeChatbot = document.getElementById("closeChatbot");
        const chatbotInput = document.getElementById("chatbotInput");
        const sendChatbotMessage = document.getElementById("sendChatbotMessage");
        const chatbotMessages = document.getElementById("chatbotMessages");
        
        // Google Gemini API configuration
        const GOOGLE_API_KEY = 'AIzaSyDudnt6l_RVPTuwnnj0VqrtLq8WVDewrMY';
        const API_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GOOGLE_API_KEY}`;
        
        // Sample credit knowledge base
        const creditKnowledge = {
            "what is a credit score": "📊 A credit score is a 3-digit number (typically 300-850) that represents your creditworthiness. Lenders use it to evaluate how likely you are to repay debts. Higher scores = better loan terms! 💰",
            
            "how is your credit score calculated": "🧮 Your credit score is calculated using:\n\n• Payment history (35%) 💳\n• Credit utilization (30%) 📉\n• Credit age (15%) 🕰️\n• Credit mix (10%) 🎭\n• New credit (10%) 🆕\n\nEach scoring model (FICO, VantageScore) weighs these slightly differently.",
            
            "credit score ranges": "📈 Credit score ranges:\n\n• 300-579: Poor 😞\n• 580-669: Fair 😐\n• 670-739: Good 😊\n• 740-799: Very Good 👍\n• 800-850: Excellent 🎉\n\nHigher scores get you better interest rates!",
            
            "how to check your credit report": "🔍 You can check your credit report for FREE at AnnualCreditReport.com. By law, you get 1 free report from each bureau (Experian, Equifax, TransUnion) every year. Pro tip: Stagger them to monitor year-round! 📅",
            
            "tips for increasing your credit score": "🚀 Boost your score with these tips:\n\n1. Pay bills on time ⏰\n2. Keep credit utilization <30% 📉\n3. Don't close old accounts 🕰️\n4. Limit hard inquiries 🛑\n5. Diversify credit types 🎭\n6. Dispute errors on your report 🔍\n7. Become an authorized user 👪",
            
            "how to build credit without a credit card": "🛠️ No credit card? No problem! Try:\n\n• Credit-builder loans 🏦\n• Secured credit cards 💳\n• Reporting rent payments 🏠\n• Becoming an authorized user 👪\n• Utility bill reporting 💡\n\nStart small and build responsibly!",
            
            "common credit mistakes": "⚠️ Avoid these credit killers:\n\n• Maxing out credit cards 💣\n• Missing payments ❌\n• Applying for too much credit at once 🎯\n• Closing old accounts 🚪\n• Ignoring your credit report 🙈\n• Cosigning without caution ✍️",
            
            "how credit score affects loan interest rates": "💸 Your score DIRECTLY impacts rates! Example:\n\n• 760+ score: 3.5% APR 🎉\n• 700 score: 4.0% APR 🙂\n• 620 score: 5.0% APR 😕\n\nOn a $300k mortgage, that's $100k+ difference over 30 years!",
            
            "how to dispute incorrect information": "⚖️ Dispute errors in 6 steps:\n\n1. Get your credit report 📄\n2. Identify errors 🔍\n3. Gather evidence 📸\n4. Submit dispute to bureau(s) ✉️\n5. Follow up within 30 days 📅\n6. If unresolved, file CFPB complaint 🏛️",
            
            "credit monitoring tools": "🛡️ Top monitoring options:\n\n• Credit Karma (free) 🆓\n• Experian (free version) 🆓\n• myFICO (most comprehensive) 💯\n• Your bank's tools 🏦\n\nLook for: real-time alerts, score simulators, and dark web monitoring!"
        };
        
        // Toggle chatbot window
        chatbotIcon.addEventListener("click", () => {
            chatbotWindow.style.display = "flex";
        });
        
        closeChatbot.addEventListener("click", () => {
            chatbotWindow.style.display = "none";
        });
        
        // Send message function
        function sendMessage() {
            const message = chatbotInput.value.trim();
            if (message === "") return;
            
            // Add user message to chat
            addMessage(message, "user");
            chatbotInput.value = "";
            
            // Check if we have a predefined response
            const lowerMessage = message.toLowerCase();
            let foundResponse = false;
            
            for (const [key, value] of Object.entries(creditKnowledge)) {
                if (lowerMessage.includes(key)) {
                    addMessage(value, "bot");
                    foundResponse = true;
                    break;
                }
            }
            
            // If no predefined response, use Gemini API
            if (!foundResponse) {
                addMessage("Thinking...", "bot");
                
                // Prepare the request for Gemini API
                const requestBody = {
                    contents: [{
                        parts: [{
                            text: `You are a helpful credit score advisor. Answer this question about credit scores in a professional but friendly manner: ${message}`
                        }]
                    }]
                };
                
                fetch(API_URL, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(requestBody)
                })
                .then(response => response.json())
                .then(data => {
                    // Remove "Thinking..." message
                    chatbotMessages.removeChild(chatbotMessages.lastChild);
                    
                    // Add the actual response
                    if (data.candidates && data.candidates[0].content.parts[0].text) {
                        addMessage(data.candidates[0].content.parts[0].text, "bot");
                    } else {
                        addMessage("I couldn't find an answer to that. Could you try asking differently?", "bot");
                    }
                })
                .catch(error => {
                    console.error("Error calling Gemini API:", error);
                    chatbotMessages.removeChild(chatbotMessages.lastChild);
                    addMessage("I'm having trouble connecting to the credit database. Please try again later.", "bot");
                });
            }
        }
        
        // Add message to chat
        function addMessage(text, sender) {
            const messageDiv = document.createElement("div");
            messageDiv.classList.add("message", `${sender}-message`);
            messageDiv.textContent = text;
            chatbotMessages.appendChild(messageDiv);
            chatbotMessages.scrollTop = chatbotMessages.scrollHeight;
        }
        
        // Event listeners for sending messages
        sendChatbotMessage.addEventListener("click", sendMessage);
        chatbotInput.addEventListener("keypress", (e) => {
            if (e.key === "Enter") {
                sendMessage();
            }
        });
        
        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });
        
        // Animation on scroll
        const fadeElements = document.querySelectorAll('.fade-in');
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = 1;
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, { threshold: 0.1 });
        
        fadeElements.forEach(element => {
            element.style.opacity = 0;
            element.style.transform = 'translateY(20px)';
            element.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(element);
        });
    </script>
